# Optional: uv run --env-file .env python manage.py runserver
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-secret-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SITE_ORIGIN=http://localhost:8000

# Both integrations are optional. Never commit real values.
STEAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Future PostgreSQL migration (install psycopg first; see README):
# DB_ENGINE=postgresql
# DB_NAME=nextplay
# DB_USER=nextplay
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Steam Web API key.
STEAM_WEB_API_KEY=
# OpenAI-compatible Chat Completions provider (local Ollama defaults).
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_MODEL=qwen3.5:latest
OPENAI_COMPATIBLE_API_KEY=
# Ollama Qwen models think by default; use "none" to reserve tokens for the answer.
OPENAI_COMPATIBLE_REASONING_EFFORT=none
OPENAI_COMPATIBLE_MAX_TOKENS=5000
# OpenAI: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Set a unique secret before deploying with DJANGO_DEBUG=0.
# DJANGO_SECRET_KEY=